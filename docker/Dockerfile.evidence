# Serve only. The Evidence compile happens in a Cloud Build step rather than a build stage here,
# because `evidence sources` queries BigQuery and a docker build has no access to the build
# machine's credentials. Doing it as a step keeps Application Default Credentials available and
# keeps this image free of anything that could hold a credential.
FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY evidence/build /usr/share/nginx/html

EXPOSE 8080
